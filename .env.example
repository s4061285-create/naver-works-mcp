# 네이버웍스 로그인 이메일과 "외부 앱 비밀번호"
# (네이버웍스 웹 -> 프로필 -> 개인 설정 -> 보안 -> 외부 앱 비밀번호)
# 이 값 하나로 메일(IMAP/SMTP)과 캘린더(CalDAV) 도구가 모두 동작합니다.
NAVER_EMAIL="your-email@domain.com"
NAVER_APP_PASSWORD="generated-external-app-password"

# 보통 바꿀 필요 없음 (캘린더 CalDAV 서버 주소)
NAVER_CALDAV_SERVER="https://caldav.worksmobile.com"

# 메일 첨부파일 저장 기본 폴더 (선택, 비워두면 시스템 임시 폴더 사용)
# ATTACHMENT_DIR="C:\path\to\attachments"

# 휴지통 폴더명 (비워두면 IMAP 폴더 목록에서 자동 탐색.
# 자동 탐색이 안 되면 list_mail_folders()로 확인 후 여기에 지정)
TRASH_FOLDER=

# delete_local_file()이 삭제를 허용할 폴더 (; 또는 , 로 여러 개 지정 가능)
DELETE_ALLOWED_DIRS=

# 개인 서명 파일 경로 (선택, 기본값: 서버 폴더의 signature.html / signature.txt)
# SIGNATURE_HTML_FILE=
# SIGNATURE_TEXT_FILE=
